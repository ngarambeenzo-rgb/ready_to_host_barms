# Product photos only — nothing in here may ever run as a script.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php5 .php7 .php8 .pl .py .cgi .sh
RemoveType .php .phtml .phar .php5 .php7 .php8
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
# Only serve image files
<FilesMatch "^(?!.*\.(jpe?g|png|webp)$).*$">
  Require all denied
</FilesMatch>
